# Normalize line endings in the repository, keep shell scripts runnable on Linux/macOS.
* text=auto eol=lf

*.sh            text eol=lf
*.cs            text eol=lf
*.csproj        text eol=lf
*.props         text eol=lf
*.md            text eol=lf
*.resx          text eol=lf
*.xml           text eol=lf
*.svg           text eol=lf
*.yml           text eol=lf

*.png           binary
*.ico           binary
*.mpack         binary
